// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN      // Administrador - full access
  MEMBER          // Miembro - can suggest songs, upload media, vote
  STUDENT_GUEST   // Estudiante/Invitado - view only (default)
}

enum SongStatus {
  PENDING
  REHEARSING
  READY
  ARCHIVED
}

enum AssetType {
  SCORE
  VIDEO
  AUDIO
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  avatarUrl      String?  // Profile picture URL
  homeBackground String?  // Home background: preset name (e.g., "aurora") or custom image URL
  role           Role     @default(STUDENT_GUEST)
  instruments    String[]
  phone          String?
  bio            String?  // Short user bio
  jobTitle       String?  // From Azure AD
  department     String?  // From Azure AD
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  suggestions Song[]      @relation("UserSuggestions")
  leadVocals  Song[]      @relation("SongLeadVocals")
  songVotes   SongVote[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Song {
  id          String     @id @default(uuid())
  title       String
  artist      String
  bpm         Int?
  key         String?
  genre       String?
  status      SongStatus @default(PENDING)
  coverUrl    String?
  durationMs  Int?
  releaseDate DateTime?
  isrc        String?    @unique

  // Music platform links for listening
  spotifyUrl    String?
  youtubeUrl    String?
  appleMusicUrl String?

  // Relations
  suggestedBy   User?   @relation("UserSuggestions", fields: [suggestedById], references: [id])
  suggestedById String?

  leadVocals    User[]  @relation("SongLeadVocals")

  versions      SongVersion[]
  tags          Tag[]
  eventSongs    EventSong[]    // Explicit junction for events
  concertSongs  ConcertSong[]  // Explicit junction for concerts
  assets        Asset[]
  votes         SongVote[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("songs")
}

// Voting system for song suggestions
model SongVote {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, songId])  // Each user can only vote once per song
  @@map("song_votes")
}

model SongVersion {
  id          String   @id @default(uuid())
  name        String   // e.g., "Studio", "Live", "Remix"
  songId      String
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("song_versions")
}

model Event {
  id          String   @id @default(uuid())
  name        String
  description String?

  // Visual customization (like RepertoireSection)
  iconName         String?  // Lucide icon name (e.g., "TreePine", "GraduationCap", "Music")
  bannerUrl        String?  // Custom banner image URL
  // Gradient colors for styling
  gradientFrom     String?  // e.g., "red-600/60"
  gradientVia      String?  // e.g., "red-700/40"
  gradientTo       String?  // e.g., "transparent"
  // Icon background gradient
  iconGradientFrom String?  // e.g., "red-600"
  iconGradientTo   String?  // e.g., "red-700"

  eventSongs  EventSong[]  // Explicit junction for ordering
  concerts    Concert[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// Junction table for Event-Song with ordering
model EventSong {
  id        String   @id @default(uuid())
  eventId   String
  songId    String
  order     Int      @default(0)  // Position in setlist
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, songId])
  @@map("event_songs")
}

model Concert {
  id          String   @id @default(uuid())
  date        DateTime
  location    String?
  notes       String?

  // Parent event
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String

  // Explicit junction for songs with ordering
  concertSongs ConcertSong[]

  // Videos of this specific performance
  assets      Asset[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("concerts")
}

// Junction table for Concert-Song with ordering
model ConcertSong {
  id        String   @id @default(uuid())
  concertId String
  songId    String
  order     Int      @default(0)  // Position in setlist
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([concertId, songId])
  @@map("concert_songs")
}

model Asset {
  id            String    @id @default(uuid())
  type          AssetType
  url           String    // Local path or URL
  name          String?   // Display name for the asset
  instrumentTag String?   // e.g., "Alto Sax" (for scores)

  // Can belong to a Song (scores, practice videos) OR a Concert (performance videos)
  songId        String?
  song          Song?     @relation(fields: [songId], references: [id], onDelete: Cascade)

  concertId     String?
  concert       Concert?  @relation(fields: [concertId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@map("assets")
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  songs Song[]

  @@map("tags")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  metadata  Json?
  timestamp DateTime @default(now())

  @@map("audit_logs")
}

model RepertoireSection {
  id              String   @id @default(uuid())
  key             String   @unique  // "repertorio", "sugerencias", "archivadas"
  title           String
  subtitle        String?
  iconName        String?  // Lucide icon name (e.g., "Library", "Clock", "Archive")
  bannerUrl       String?  // Custom banner image URL
  // Gradient colors for default/fallback styling
  gradientFrom    String?  // e.g., "brand-blue-primary/40"
  gradientVia     String?  // e.g., "indigo-600/20"
  gradientTo      String?  // e.g., "transparent"
  // Icon background gradient
  iconGradientFrom String? // e.g., "brand-blue-primary"
  iconGradientTo   String? // e.g., "indigo-600"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("repertoire_sections")
}
