// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN      // Administrador - full access
  MEMBER          // Miembro - can suggest songs, upload media, vote
  STUDENT_GUEST   // Estudiante/Invitado - view only (default)
}

enum SongStatus {
  PENDING
  REHEARSING
  READY
  ARCHIVED
}

enum AssetType {
  SCORE
  VIDEO
  AUDIO
}

enum BlockType {
  INTERLUDE      // Interludio
  INTRODUCTION   // Introduccion
  BREAK          // Descanso
  TRANSITION     // Transicion
  CUSTOM         // Personalizado
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  avatarUrl      String?  // Profile picture URL
  homeBackground String?  // Home background: preset name (e.g., "aurora") or custom image URL
  role           Role     @default(STUDENT_GUEST)
  instruments    String[]
  phone          String?
  bio            String?  // Short user bio
  jobTitle       String?  // From Azure AD
  department     String?  // From Azure AD

  // Multi-provider auth fields
  passwordHash   String?              // For email/password auth (bcrypt)
  googleId       String?  @unique     // Google OAuth subject ID
  authProvider   String   @default("azure_ad") // "azure_ad" | "google" | "email_password"
  emailVerified  Boolean  @default(false)      // Auto-true for Azure AD & Google
  preferences    Json?    // UI preferences: { seenAppVersion, completedTours, hasSeenWelcome }

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  suggestions            Song[]      @relation("UserSuggestions")
  leadVocals             Song[]      @relation("SongLeadVocals")
  songVotes              SongVote[]
  auditLogs              AuditLog[]
  rehearsalAttendances   RehearsalAttendance[]

  @@map("users")
}

model Song {
  id          String     @id @default(uuid())
  title       String
  artist      String
  bpm         Int?
  key         String?
  genre       String?
  status      SongStatus @default(PENDING)
  coverUrl    String?
  durationMs  Int?
  releaseDate DateTime?
  isrc        String?    @unique

  // Music platform links for listening
  spotifyUrl    String?
  youtubeUrl    String?
  appleMusicUrl String?

  // Relations
  suggestedBy   User?   @relation("UserSuggestions", fields: [suggestedById], references: [id])
  suggestedById String?

  leadVocals    User[]  @relation("SongLeadVocals")

  versions      SongVersion[]
  tags          Tag[]
  eventSongs     EventSong[]     // Explicit junction for events
  concertSongs   ConcertSong[]   // Explicit junction for concerts
  rehearsalSongs RehearsalSong[] // Explicit junction for rehearsals
  assets         Asset[]
  votes          SongVote[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("songs")
}

// Voting system for song suggestions
model SongVote {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  isGolden  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, songId])  // Each user can only vote once per song
  @@map("song_votes")
}

model SongVersion {
  id          String   @id @default(uuid())
  name        String   // e.g., "Studio", "Live", "Remix"
  songId      String
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("song_versions")
}

model Event {
  id          String   @id @default(uuid())
  name        String
  description String?

  // Visual customization (like RepertoireSection)
  iconName         String?  // Lucide icon name (e.g., "TreePine", "GraduationCap", "Music")
  bannerUrl        String?  // Custom banner image URL
  // Gradient colors for styling
  gradientFrom     String?  // e.g., "red-600/60"
  gradientVia      String?  // e.g., "red-700/40"
  gradientTo       String?  // e.g., "transparent"
  // Icon background gradient
  iconGradientFrom String?  // e.g., "red-600"
  iconGradientTo   String?  // e.g., "red-700"

  eventSongs  EventSong[]   // Explicit junction for ordering
  eventBlocks EventBlock[]  // Non-song setlist items (interludes, breaks, etc.)
  concerts    Concert[]
  rehearsals  Rehearsal[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

// Junction table for Event-Song with ordering
model EventSong {
  id        String   @id @default(uuid())
  eventId   String
  songId    String
  order     Int      @default(0)  // Position in setlist
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, songId])
  @@map("event_songs")
}

model Concert {
  id          String   @id @default(uuid())
  date        DateTime
  location    String?
  notes       String?

  // Parent event
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String

  // Explicit junction for songs with ordering
  concertSongs  ConcertSong[]
  concertBlocks ConcertBlock[]  // Non-song setlist items

  // Videos of this specific performance
  assets      Asset[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("concerts")
}

// Junction table for Concert-Song with ordering
model ConcertSong {
  id        String   @id @default(uuid())
  concertId String
  songId    String
  order     Int      @default(0)  // Position in setlist
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([concertId, songId])
  @@map("concert_songs")
}

// Non-song setlist items for Events (interludes, breaks, introductions, etc.)
model EventBlock {
  id              String    @id @default(uuid())
  eventId         String
  type            BlockType @default(CUSTOM)
  label           String
  durationMinutes Int?
  notes           String?
  order           Int       @default(0)
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@map("event_blocks")
}

// Non-song setlist items for Concerts (interludes, breaks, introductions, etc.)
model ConcertBlock {
  id              String    @id @default(uuid())
  concertId       String
  type            BlockType @default(CUSTOM)
  label           String
  durationMinutes Int?
  notes           String?
  order           Int       @default(0)
  concert         Concert   @relation(fields: [concertId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@map("concert_blocks")
}

model Asset {
  id            String    @id @default(uuid())
  type          AssetType
  url           String    // Local path or URL
  name          String?   // Display name for the asset
  instrumentTag String?   // e.g., "Alto Sax" (for scores)

  // Can belong to a Song, Concert, or Rehearsal
  songId        String?
  song          Song?     @relation(fields: [songId], references: [id], onDelete: Cascade)

  concertId     String?
  concert       Concert?  @relation(fields: [concertId], references: [id], onDelete: Cascade)

  rehearsalId   String?
  rehearsal     Rehearsal? @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@map("assets")
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  songs Song[]

  @@map("tags")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  metadata  Json?
  timestamp DateTime @default(now())

  @@map("audit_logs")
}

model Location {
  id           String      @id @default(uuid())
  name         String                          // e.g., "Auditorio PUCMM", "Sala de Ensayos"
  address      String?
  latitude     Float
  longitude    Float
  radiusMeters Int         @default(200)       // GPS validation radius in meters

  rehearsals   Rehearsal[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("locations")
}

model Rehearsal {
  id          String    @id @default(uuid())
  date        DateTime
  notes       String?

  // Optional parent event (null = generic rehearsal)
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String?

  // Predefined location with GPS coordinates
  location    Location  @relation(fields: [locationId], references: [id])
  locationId  String

  rehearsalSongs  RehearsalSong[]
  rehearsalBlocks RehearsalBlock[]
  attendances     RehearsalAttendance[]
  assets          Asset[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("rehearsals")
}

// Junction table for Rehearsal-Song with ordering
model RehearsalSong {
  id          String    @id @default(uuid())
  rehearsalId String
  songId      String
  order       Int       @default(0)
  rehearsal   Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  song        Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([rehearsalId, songId])
  @@map("rehearsal_songs")
}

// Non-song setlist items for Rehearsals
model RehearsalBlock {
  id              String    @id @default(uuid())
  rehearsalId     String
  type            BlockType @default(CUSTOM)
  label           String
  durationMinutes Int?
  notes           String?
  order           Int       @default(0)
  rehearsal       Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@map("rehearsal_blocks")
}

model RehearsalAttendance {
  id          String           @id @default(uuid())
  rehearsalId String
  userId      String
  status      AttendanceStatus @default(PRESENT)
  checkedInAt DateTime         @default(now())
  latitude    Float?           // GPS coordinates at check-in time
  longitude   Float?
  markedBy    String?          // userId of admin if marked by SUPERADMIN
  notes       String?

  rehearsal   Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([rehearsalId, userId])
  @@map("rehearsal_attendances")
}

model RepertoireSection {
  id              String   @id @default(uuid())
  key             String   @unique  // "repertorio", "sugerencias", "archivadas"
  title           String
  subtitle        String?
  iconName        String?  // Lucide icon name (e.g., "Library", "Clock", "Archive")
  bannerUrl       String?  // Custom banner image URL
  // Gradient colors for default/fallback styling
  gradientFrom    String?  // e.g., "brand-blue-primary/40"
  gradientVia     String?  // e.g., "indigo-600/20"
  gradientTo      String?  // e.g., "transparent"
  // Icon background gradient
  iconGradientFrom String? // e.g., "brand-blue-primary"
  iconGradientTo   String? // e.g., "indigo-600"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("repertoire_sections")
}

model Organization {
  id              String   @id @default(uuid())
  name            String                          // e.g., "Banda Universitaria PUCMM"
  slug            String   @unique                // e.g., "pucmm-band"
  domain          String?                         // e.g., "pucmm-band.cjoga.cloud"
  description     String?
  logoUrl         String?
  logoInitial     String?                         // Single character, e.g., "P"

  // Branding - hex color values
  colorPrimary    String   @default("#0033A0")
  colorSecondary  String   @default("#FFD200")
  colorAccent     String   @default("#D22630")

  // Auth configuration
  allowedEmailDomains String[]                    // e.g., ["ce.pucmm.edu.do"]
  superadminEmail     String

  // Metadata for SEO / public pages
  metaTitle       String?
  metaDescription String?
  locale          String   @default("es")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authProviders   AuthProvider[]

  @@map("organizations")
}

model AuthProvider {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider       String                           // "azure_ad", "google", "email_password"
  enabled        Boolean      @default(true)
  isPrimary      Boolean      @default(false)
  displayName    String?                          // e.g., "Correo Estudiantil PUCMM"
  config         Json         @default("{}")      // Provider-specific config (tenantId, clientId, etc.)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider])
  @@map("auth_providers")
}
