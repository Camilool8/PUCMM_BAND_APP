# Database
DATABASE_URL="postgresql://pucmm_band:pucmm_band_2024@localhost:5433/pucmm_band"

# Azure AD Authentication
AZURE_AD_TENANT_ID="your-tenant-id"
AZURE_AD_CLIENT_ID="your-client-id"
AZURE_AD_CLIENT_SECRET="your-client-secret"

# Server
PORT=3001

# CORS - comma-separated allowed frontend origins
CORS_ORIGINS="https://pucmm-band.cjoga.cloud"

# Spotify API (OPTIONAL - enhances music metadata with ISRC)
# iTunes is used as primary source (free, no auth needed)
# Get credentials at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# GetSongBPM API (optional, for additional BPM/key data)
# Get API key at https://getsongbpm.com/api
GETSONGBPM_API_KEY=""
